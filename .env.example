# Copier en .env et adapter si besoin. Toutes les valeurs sont optionnelles.

# Adresse du proxy info-orbs (nginx du conteneur Docker)
UPSTREAM_URL=http://192.168.1.74:8100

# Port publié sur l'hôte par docker compose (le conteneur écoute toujours sur 3100)
SCOREWEB_PORT=3100

# Port d'écoute quand on lance `npm start` sans Docker
# PORT=3100

# Fuseau des heures affichées (doit correspondre à ce que le proxy reçoit en ?tz=)
# DISPLAY_TZ=Europe/Paris

# Rafraîchissement serveur → proxy, en secondes : pendant un match / le reste du temps
# LIVE_REFRESH_SECONDS=15
# IDLE_REFRESH_SECONDS=300

# Durée de cache des classements (secondes) et de l'index des équipes (heures)
# STANDINGS_REFRESH_SECONDS=600
# TEAMS_REFRESH_HOURS=12

# Délai maximal d'une requête vers le proxy (ms)
# UPSTREAM_TIMEOUT_MS=8000

# Dossier du cache des logos (défaut : ./cache/logos)
# LOGO_CACHE_DIR=./cache/logos
